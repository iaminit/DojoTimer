# Copia questo file in ~/.android/dojo-timer/keystore.properties (oppure in android/keystore.properties)
# o passa le variabili d'ambiente DOJO_UPLOAD_STORE_FILE / DOJO_UPLOAD_STORE_PASSWORD /
# DOJO_UPLOAD_KEY_ALIAS / DOJO_UPLOAD_KEY_PASSWORD in fase di build.
storeFile=/percorso/privato/dojo-release-key.jks
storePassword=SOSTITUISCI_STORE_PASSWORD
keyAlias=dojo-timer
keyPassword=SOSTITUISCI_KEY_PASSWORD
